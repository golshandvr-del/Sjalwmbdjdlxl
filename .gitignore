/build/
/dist/
*.pck
*.zip
*.apk
*.aab
*.exe
*.dmg

# User data / local saves
user://

# Local test/lint run logs (agent scratch)
tests/_lastrun.log
tests/_lint.log

# OS / editor cruft
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
.github/workflows/
